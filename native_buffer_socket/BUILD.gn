import("//build/ohos.gni")
import("//foundation/graphic/graphic_surface/graphic_surface_config.gni")

config("native_buffer_socket_config") {
  visibility = [
    ":native_buffer_socket",
    ":native_buffer_socket_static",
  ]

  cflags = [
    "-Wall",
    "-Werror",
    "-g3",
  ]
}

config("native_buffer_socket_public_config") {
  include_dirs = [
    "$graphic_surface_root/interfaces/inner_api/surface",
  ]
}

ohos_shared_library("native_buffer_socket") {
  deps = [ ":native_buffer_socket_static" ]

  sanitize = {
    boundary_sanitize = true
    integer_overflow = true
    ubsan = true
  }

  public_configs = [ ":native_buffer_socket_public_config" ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "hilog:libhilog",
  ]

  innerapi_tags = [
    "platformsdk",
  ]

  part_name = "graphic_surface"
  subsystem_name = "graphic"
}

ohos_static_library("native_buffer_socket_static") {
  sources = [ "src/native_buffer_socket.cpp" ]

  configs = [ ":native_buffer_socket_config" ]

  public_configs = [ ":native_buffer_socket_public_config" ]

  deps = [
    "$graphic_surface_root/buffer_handle:buffer_handle",
    "$graphic_surface_root/surface:surface_static",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "hilog:libhilog",
  ]

  part_name = "graphic_surface"
  subsystem_name = "graphic"
}
